#!/usr/bin/env ruby

require_relative "../lib/main"

# Parse command-line arguments
command = ARGV[0]
command_args = ARGV[1..-1]

unless command
  puts "Usage: cli <command> [args]"
  exit
end

# TODO: initialize the controller

input_lines = []
if $stdin.tty? # Check if the input is from an interactive terminal
  loop do
    input = gets
    break if input == 'EOF'

    input = input.chomp
    break if input == EXIT_COMMAND || input.strip.empty?

    input_lines << input
  end
else
  # Non-interactive input, e.g., file or piped data
  input_lines = $stdin.read.split("\n")
end
